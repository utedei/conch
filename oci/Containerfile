FROM rust:bookworm AS builder
WORKDIR /build
COPY Cargo.toml Cargo.lock build.rs ./
COPY src ./src
# needed for build.rs to get the git commit hash
COPY .git ./.git
ARG RUST_TARGET
ARG CARGO_PROFILE=debug
RUN apt-get update \
	&& apt-get install --yes --no-install-recommends musl-tools \
	&& rm -rf /var/lib/apt/lists/* \
	&& rustup target add "${RUST_TARGET}"
RUN set -eu; \
	target_env=$(printf '%s' "${RUST_TARGET}" | sed 's/-/_/g' | tr '[:lower:]' '[:upper:]'); \
	linker_arch=${RUST_TARGET%%-*}; \
	linker="${linker_arch}-linux-musl-gcc"; \
	ln -s "$(command -v musl-gcc)" "/usr/local/bin/${linker}"; \
	export "CC_${target_env}=musl-gcc"; \
	export "CARGO_TARGET_${target_env}_LINKER=${linker}"; \
	if [ "${CARGO_PROFILE}" = release ]; then \
		cargo build --locked --target "${RUST_TARGET}" --release; \
	else \
		cargo build --locked --target "${RUST_TARGET}"; \
	fi

FROM gcr.io/distroless/static-debian12
ARG RUST_TARGET
ARG CARGO_PROFILE=debug
COPY --from=builder /build/target/${RUST_TARGET}/${CARGO_PROFILE}/conch /conch
USER 65534:65534
ENTRYPOINT ["/conch"]
