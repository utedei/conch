FROM rust:bookworm AS builder
WORKDIR /build
COPY Cargo.toml Cargo.lock build.rs ./
COPY src ./src
# needed for build.rs to get the git commit hash
COPY .git ./.git
ARG CARGO_PROFILE=debug
RUN if [ "${CARGO_PROFILE}" = release ]; then cargo build --locked --release; else cargo build --locked; fi

FROM gcr.io/distroless/cc-debian12
ARG CARGO_PROFILE=debug
COPY --from=builder /build/target/${CARGO_PROFILE}/conch /conch
USER 65534:65534
ENTRYPOINT ["/conch"]
